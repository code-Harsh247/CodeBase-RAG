NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required, no default. Pick a long random value.
NEO4J_PASSWORD=

# Interactive use costs roughly $0.005 a question, so a few dollars of credit
# lasts a long time. See docs/ARCHITECTURE.md section 2.4a.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder

CHROMA_PERSIST_DIR=./.chroma

# --- Server -----------------------------------------------------------------
# "production" disables /docs and the dev CORS origins.
APP_ENV=development
# Comma-separated. Leave empty in production when the UI is same-origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where clones live (default: ./.repos).
REPOS_DIR=
# Users, sessions and repo ownership (SQLite). Default: ./.data/app.db
APP_DB_PATH=

# --- Sign in with GitHub ------------------------------------------------------
# Register an OAuth App at GitHub > Settings > Developer settings > OAuth Apps.
# Callback URL: <PUBLIC_BASE_URL>/api/auth/callback. No scopes are requested.
PUBLIC_BASE_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins that can delete any repo and force re-indexing.
ADMIN_GITHUB_LOGINS=
SESSION_TTL_DAYS=30
# Development only (refused when APP_ENV=production): act as this login
# without signing in.
AUTH_DEV_USER=
# Comma-separated owner/name repos every user can see. When set, this is the
# full list; when empty, the flags set with `codegraph admin public` stand.
PUBLIC_REPOS=

# --- Ingestion limits ---------------------------------------------------------
# Fine-grained GitHub token with NO permissions (public data only), used to
# check a repository's size before cloning: 5,000 lookups/hour instead of 60.
GITHUB_TOKEN=
MAX_REPO_SIZE_MB=200
MAX_CLONE_DISK_MB=300
CLONE_TIMEOUT_SECONDS=90
INGEST_DEADLINE_SECONDS=300
MAX_PY_FILES=2000
MAX_PY_TOTAL_MB=30
MAX_GRAPH_NODES=60000
MIN_FREE_DISK_GB=5
MAX_REPOS_PER_USER=5
# Ingestions waiting behind the one running before new ones get "busy".
INGEST_QUEUE_MAX=3
# Eviction of unused repositories. Off by default outside production (so local
# repos are never deleted); in production defaults to 50 repos / 7 days idle.
# Set to 0 to disable explicitly.
MAX_INDEXED_REPOS=
REPO_IDLE_TTL_DAYS=

# --- Limits on model-driven tools --------------------------------------------
NEO4J_QUERY_TIMEOUT_SECONDS=5
NEO4J_MAX_ROWS=200
GREP_TIMEOUT_SECONDS=2
