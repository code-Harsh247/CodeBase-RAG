NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# Default provider. Interactive use costs roughly $0.005 a question, so a few
# dollars of credit lasts a long time. See docs/ARCHITECTURE.md section 2.4a.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder

# Free alternative, selectable with `--provider groq`. Its 200,000 tokens/day
# cap affords only 20-40 questions a day, which runs out mid-session when
# using the web UI — fine for occasional CLI queries.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

CHROMA_PERSIST_DIR=./.chroma
